#!/bin/bash
set -euo pipefail
# Do not overwrite a running copy while it could still be committing a book.
CONSOLE_USER="$(stat -f %Su /dev/console)"
if [[ "$CONSOLE_USER" == root || "$CONSOLE_USER" == loginwindow ]]; then exit 0; fi
CONSOLE_UID="$(id -u "$CONSOLE_USER")"
if pgrep -f '^/Applications/KindleDock.app/Contents/MacOS/KindleDock$' >/dev/null; then
  launchctl asuser "$CONSOLE_UID" sudo -H -u "$CONSOLE_USER" open kindledock://quit || true
  for _ in {1..20}; do
    if ! pgrep -f '^/Applications/KindleDock.app/Contents/MacOS/KindleDock$' >/dev/null; then exit 0; fi
    sleep 0.5
  done
  echo 'Finish transfers and quit KindleDock before installing this update.' >&2
  exit 1
fi
